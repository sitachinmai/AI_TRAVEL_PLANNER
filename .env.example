# ===================================================
# AI TRAVEL PLANNER - PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================

# Application Environment (production / development)
ENV=production
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=https://your-app-name.onrender.com

# Security Secret Key (Generate a random 32+ character string in production)
SECRET_KEY=change-this-to-a-random-secure-secret-key-in-production

# Allowed CORS Origins (Comma separated or * for all)
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# Database Connection URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./data/travel_planner.db

# Optional AI Gemini API Key (Self-contained travel recommendation engine included)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional SMTP Email Configuration for Real OTP Delivery
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=AI Travel Planner
